{
  "name": "cascade",
  "version": "0.2.0",
  "description": "Visual programming for generative art",
  "type": "module",
  "main": "electron/main.js",
  "bin": {
    "cascade": "./dist/cli/index.js"
  },
  "scripts": {
    "dev": "vite",
    "dev:client": "vite",
    "build": "vite build",
    "build:cli": "tsc --project tsconfig.cli.json",
    "build:electron": "tsc --project tsconfig.electron.json && tsc --project tsconfig.preload.json",
    "preview": "vite preview",
    "check": "svelte-check --tsconfig ./tsconfig.json",
    "test": "vitest",
    "test:run": "vitest run",
    "test:coverage": "vitest run --coverage",
    "electron:dev": "concurrently -k -n client,electron -c cyan,yellow \"npm run dev:client\" \"wait-on http://localhost:5173 && ELECTRON_RUN_AS_NODE= NODE_ENV=development electron .\"",
    "electron:preview": "npm run build && npm run build:electron && ELECTRON_RUN_AS_NODE= electron .",
    "electron:build": "npm run build && npm run build:electron && electron-builder",
    "electron:build:mac": "npm run electron:build -- --mac",
    "electron:build:win": "npm run electron:build -- --win",
    "electron:build:linux": "npm run electron:build -- --linux",
    "electron:pack": "npm run build && npm run build:electron && electron-builder --dir",
    "electron:publish": "npm run build && npm run build:electron && electron-builder --mac --publish always",
    "postinstall": "electron-builder install-app-deps || true"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.71.2",
    "@google/genai": "^1.33.0",
    "cors": "^2.8.6",
    "dockview-core": "^4.11.0",
    "electron-updater": "^6.6.2",
    "express": "^5.2.1",
    "lucide-svelte": "^0.554.0",
    "marked": "^17.0.0",
    "monaco-editor": "^0.44.0",
    "openai": "^6.14.0",
    "svelte": "^5.0.0"
  },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "^5.0.0",
    "@testing-library/svelte": "^5.2.9",
    "@testing-library/user-event": "^14.6.1",
    "@tsconfig/svelte": "^5.0.0",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^24.10.1",
    "@vitest/coverage-v8": "^4.0.15",
    "concurrently": "^9.2.1",
    "electron": "^33.4.11",
    "electron-builder": "^25.0.0",
    "jsdom": "^27.3.0",
    "svelte-check": "^4.0.0",
    "tsx": "^4.23.12",
    "typescript": "^5.0.0",
    "vite": "^6.0.0",
    "vite-plugin-monaco-editor": "^1.1.0",
    "vitest": "^4.0.15",
    "wait-on": "^8.0.0"
  },
  "build": {
    "extends": "electron-builder.yaml"
  }
}
