  "version": "1.0.0",
  "nodes": [
    {
      "id": "counter_1",
      "type": "Custom",
      "name": "Counter",
      "code": "const trigger = node.in('trigger', null, { type: 'trigger' });\nconst reset = node.in('reset', null, { type: 'trigger' });\nconst output = node.out('count');\n\nlet count = 0;\n\nif (trigger) {\n  trigger.onTrigger = () => {\n    count++;\n    output.setValue(count);\n    node.log('Count:', count);\n  };\n}\n\nif (reset) {\n  reset.onTrigger = () => {\n    count = 0;\n    output.setValue(0);\n    node.log('Reset to 0');\n  };\n}\n",
      "position": { "x": 200, "y": 200 },
      "comment": "A simple counter that increments on trigger",
      "inputs": [
        {
          "id": "counter_1_in_trigger",
          "name": "trigger",
          "portType": "trigger",
          "dataType": "trigger",
          "value": null,
          "defaultValue": null
        },
        {
          "id": "counter_1_in_reset",
          "name": "reset",
          "portType": "trigger",
          "dataType": "trigger",
          "value": null,
          "defaultValue": null
        }
      ],
      "outputs": [
