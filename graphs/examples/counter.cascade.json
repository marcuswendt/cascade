          "dataType": "number",
          "value": 0
        }
      ]
    },
    {
      "id": "timer_1",
      "type": "Timer",
      "name": "Timer",
      "code": "const trigger = node.in('trigger', null, { type: 'trigger' });\nconst interval = node.in('interval', 500);\nconst output = node.out('tick');\n\nlet timerId = null;\n\nif (trigger) {\n  trigger.onTrigger = () => {\n    if (timerId) clearInterval(timerId);\n    timerId = setInterval(() => {\n      output.trigger({ time: Date.now() });\n    }, interval.value || 500);\n  };\n}\n\nnode.onDestroy = () => {\n  if (timerId) clearInterval(timerId);\n};\n",
      "position": { "x": 200, "y": 100 },
      "comment": "",
      "inputs": [
        {
          "id": "timer_1_in_trigger",
          "name": "trigger",
          "portType": "trigger",
