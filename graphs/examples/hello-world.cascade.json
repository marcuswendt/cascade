      "name": "Timer",
      "code": "const trigger = node.in('trigger', null, { type: 'trigger' });\nconst interval = node.in('interval', 1000);\nconst output = node.out('tick');\n\nlet timerId = null;\n\nif (trigger) {\n  trigger.onTrigger = () => {\n    if (timerId) clearInterval(timerId);\n    timerId = setInterval(() => {\n      output.trigger({ time: Date.now() });\n    }, interval.value || 1000);\n  };\n}\n\nnode.onDestroy = () => {\n  if (timerId) clearInterval(timerId);\n};\n",
