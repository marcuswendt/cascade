{
  "name": "@cascade/runtime",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./expressions": {
      "types": "./dist/expressions/index.d.ts",
      "default": "./dist/expressions/index.js"
    },
    "./animation": {
      "types": "./dist/animation/index.d.ts",
      "default": "./dist/animation/index.js"
    },
    "./camera": {
      "types": "./dist/camera/index.d.ts",
      "default": "./dist/camera/index.js"
    },
    "./render": {
      "types": "./dist/geometry/render.d.ts",
      "default": "./dist/geometry/render.js"
    },
    "./scene": {
      "types": "./dist/scene/index.d.ts",
      "default": "./dist/scene/index.js"
    },
    "./params": {
      "types": "./dist/params/index.d.ts",
      "default": "./dist/params/index.js"
    },
    "./node": {
      "types": "./dist/node.d.ts",
      "default": "./dist/node.js"
    },
    "./browser": {
      "types": "./dist/browser.d.ts",
      "default": "./dist/browser.js"
    },
    "./definition/extract": {
      "types": "./dist/definition/extract.d.ts",
      "default": "./dist/definition/extract.js"
    }
  },
  "files": [
    "dist"
  ],
  "dependencies": {
    "@cascade/contracts": "file:../contracts"
  },
  "devDependencies": {
    "typescript": "^6.0.3"
  },
  "scripts": {
    "build": "node ../../scripts/clean-package-dist.mjs runtime && tsc -p tsconfig.json",
    "check": "tsc -p tsconfig.json --noEmit",
    "test": "npm run build && node --test test/*.test.mjs"
  }
}
